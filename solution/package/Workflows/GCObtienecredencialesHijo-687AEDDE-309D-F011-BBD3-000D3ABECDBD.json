{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "api": {
          "name": "shared_commondataserviceforapps"
        },
        "connection": {
          "connectionReferenceLogicalName": "ovg_GC_Dataverse"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "Credencial Guid",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Escribir entrada",
                  "x-ms-content-hint": "TEXT"
                },
                "text_1": {
                  "description": "Introduzca su entrada",
                  "title": "Solicitante Guid",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "required": [
                "text",
                "text_1"
              ]
            }
          },
          "metadata": {
            "operationMetadataId": "39656a7c-9bd4-4e2e-9c5a-8c9c80cfd18f"
          }
        }
      },
      "actions": {
        "GetCredencial": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "ovg_credencials",
              "recordId": "@triggerBody()?['text']",
              "$select": "ovg_contrasenia,ovg_notaprivada"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "GetItem",
              "connectionName": "shared_commondataserviceforapps"
            }
          },
          "runAfter": {}
        },
        "Responder_a_un_flujo_de_aplicación_Power_App": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "contrasenia": {
                  "title": "Contrasenia",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                },
                "nota_privada": {
                  "title": "Nota Privada",
                  "type": "string",
                  "x-ms-content-hint": "TEXT",
                  "x-ms-dynamically-added": true
                }
              },
              "additionalProperties": {}
            },
            "statusCode": 200,
            "body": {
              "contrasenia": "@{outputs('GetCredencial')?['body/ovg_contrasenia']}",
              "nota_privada": "@{outputs('GetCredencial')?['body/ovg_notaprivada']}"
            }
          },
          "runAfter": {
            "GetCredencial": [
              "Succeeded"
            ]
          }
        },
        "Audit": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "ovg_logdecredencials",
              "item/ovg_titulo": "Credencial consultada 🟡",
              "item/ovg_credencial@odata.bind": "ovg_credencials(@{triggerBody()?['text']})",
              "item/ovg_usuario@odata.bind": "systemusers(@{triggerBody()?['text_1']})"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "connectionName": "shared_commondataserviceforapps"
            }
          },
          "runAfter": {}
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}